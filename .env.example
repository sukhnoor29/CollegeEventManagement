# Set a long, random SECRET_KEY.
SECRET_KEY=your_random_secret_key

# MySQL (recommended):
# DATABASE_URL=mysql+pymysql://event_app:my_password@localhost:3306/college_event_management?charset=utf8mb4
# SQLite (for quick demo):
# DATABASE_URL=sqlite:///event_management.db

DATABASE_URL=mysql+pymysql://event_app:my_password@localhost:3306/college_event_management?charset=utf8mb4

# Optional: set to 1 to enable Flask debug mode locally.
FLASK_DEBUG=1

# Timezone used for event dates and times entered in the browser.
APP_TIMEZONE=Asia/Kolkata
